<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_password_form" model="ir.ui.view">
        <field name="name">update.password.wizard.form</field>
        <field name="model">update.password.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="acitve_id" readonly="True" />
                    <field name="customer_name" readonly="True"/> 
                    <field name="device_id"  readonly="True"/>
                    <field name="name" />
                    <field name="ip_name" />
                    <field name="user_name" /> 
                    <field name="password_name" />
                    <field name="description" />
                   
                </group>
                <footer>
                    <button name="action_update" string="Update Password" type="object" class="btn-primary" />
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_password" model="ir.actions.act_window">
        <field name="name">Update Password</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">update.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>