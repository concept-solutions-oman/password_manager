<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_password_management">
        <field name="name">Password Management</field>
        <field name="description">Manage access to passwords.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_password_user" model="res.groups">
        <field name="name">Assigned passwords only</field>
        <field name="category_id" ref="module_category_password_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_password_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_password_management"/>
        <field name="implied_ids" eval="[(4, ref('group_password_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="0">
        <!-- Record Rule for Password Form: User (Restricted) -->
        <record id="rule_password_form_responsible" model="ir.rule">
            <field name="name">Password Form: Responsible Only</field>
            <field name="model_id" ref="model_password_form"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('responsible_user_ids', 'in', user.id), ('create_uid', '=', user.id)]</field>
        </record>
        
        <!-- Record Rule for Device List Lines: User (Restricted) -->
        <record id="rule_device_list_lines_responsible" model="ir.rule">
            <field name="name">Device Lines: Responsible Only</field>
            <field name="model_id" ref="model_device_list_lines"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('responsible_user_ids', 'in', user.id), ('create_uid', '=', user.id)]</field>
        </record>

        <!-- Record Rule for Password Form: Manager (All) -->
        <record id="rule_password_form_manager" model="ir.rule">
            <field name="name">Password Form: Manager All</field>
            <field name="model_id" ref="model_password_form"/>
            <field name="groups" eval="[(4, ref('group_password_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Record Rule for Device List Lines: Manager (All) -->
        <record id="rule_device_list_lines_manager" model="ir.rule">
            <field name="name">Device Lines: Manager All</field>
            <field name="model_id" ref="model_device_list_lines"/>
            <field name="groups" eval="[(4, ref('group_password_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
