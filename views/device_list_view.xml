<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_device_list_tree" model="ir.ui.view">
        <field name="name">device.list.tree</field>
        <field name="model">device.list</field>
        <field name="arch" type="xml">
            <tree editable="bottom" >
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_device_list" model="ir.actions.act_window">
        <field name="name">Device/Applications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">device.list</field>
        <field name="view_mode">tree</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Device/Application
            </p>
        </field>
    </record>
    <menuitem name="Device/Applications"
              id="menu_device_list"
              parent="menu_pasw_root"
              action="action_device_list"
              sequence="20"/>
    
</odoo>