<odoo>
    <data>
        <record id="view_task_form_inherit_invoice" model="ir.ui.view">
            <field name="name">project.task.form.inherit.invoice</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_password"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not can_see_password_button or task_status_button or password_record_count==0" >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Passwords</span>
                            <field name="password_record_count" />
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="password_access" widget="many2many_avatar_user" domain="[('id', 'in', user_ids)]" groups="project.group_project_manager"/>
                    <field name="can_see_password_button" invisible="1" />
                    <field name="task_status_button" invisible="1"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>