<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_password_form" model="ir.ui.view">
        <field name="name">password.form.form</field>
        <field name="model">password.form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="responsible_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="active" />
                    </group>
                    <notebook>
                        <page string="Password List" name="password">
                            <field name="device_password_ids">
                                <tree editable="top">
                                    <field name="device_id" />
                                    <field name="name" />
                                    <field name="url" widget="CopyClipboardChar" placeholder="e.g. https://www.google.com"/>
                                    <field name="ip_name" optional="hide"/>
                                    <field name="user_name" widget="CopyClipboardChar" />
                                    <field name="password_name" widget="CopyClipboardChar" password="True"/>
                                    <field name="responsible_user_ids" widget="many2many_avatar_user" optional="show"/>
                                    <field name="description" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="device_id" />
                                        <field name="name" />
                                        <field name="url" widget="CopyClipboardChar"/>
                                        <field name="ip_name" />
                                        <field name="user_name" widget="CopyClipboardChar"/>
                                        <field name="password_name" widget="CopyClipboardChar"/>
                                        <field name="responsible_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                        <field name="description" />
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" option="{'post_refresh' : 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_password_form_tree" model="ir.ui.view">
        <field name="name">password.form.tree</field>
        <field name="model">password.form</field>
        <field name="arch" type="xml">
            <tree >
                <field name="partner_id" optional="show"/>
                <field name="password_count" sum="Total"/>
                <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_password_form_search" model="ir.ui.view">
        <field name="name">password.form.search</field>
        <field name="model">password.form</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="create_uid"/>
                <group expand="0" string="Group By">
                    <filter string="Created By" name="group_by_create_uid" context="{'group_by': 'create_uid'}"/>
                    <filter string="Customer" name="group_by_partner_id" context="{'group_by': 'partner_id'}"/>
                </group>
                <searchpanel>
                    <field name="device_ids" select="multi" icon="fa-desktop" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    

    <record id="action_password_form" model="ir.actions.act_window">
        <field name="name">Customer Passwords</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">password.form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem name="Customer Passwords"
              id="menu_password"
              parent="menu_pasw_root"
              action="action_password_form"
              sequence="10"/>

    <record id="view_device_list_lines_tree" model="ir.ui.view">
        <field name="name">device.list.lines.tree</field>
        <field name="model">device.list.lines</field>
        <field name="arch" type="xml">
            <tree >
                <field name="device_id" />
                <field name="name" />
                <field name="url" widget="url" decoration-info="1" class="fw-bold"/>
                <field name="ip_name" />
                <field name="user_name" widget="simple_copy"/>
                <field name="password_name" widget="simple_copy"/>
                <field name="password_form_id" />
                <button name="%(password_managment.action_update_password)d" string="Update" 
                            type="action" class="oe_highlight" context="{'active_id': active_id, 'customer_name': password_form_id}" />    
            </tree>
        </field>
    </record>
    <record id="view_device_list_lines_search" model="ir.ui.view">
        <field name="name">device.list.lines.search</field>
        <field name="model">device.list.lines</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', '|' , '|', ('name', 'ilike', self), ('device_id', 'ilike', self), ('partner_id', 'ilike', self), ('user_name', 'ilike', self), ('url', 'ilike', self)]"/>
                <field name="partner_id" />
                <field name="user_name" />
                <field name="url" />
                <field name="ip_name" />
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_by_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Device/Applications" name="group_by_device_id" context="{'group_by': 'device_id'}"/>
                </group>

                <searchpanel>
                    <field name="device_id" icon="fa-desktop" enable_counters="1"/>
                    <field name="partner_id" icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="view_device_list_lines_form" model="ir.ui.view">
        <field name="name">device.list.lines.form</field>
        <field name="model">device.list.lines</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" widget="res_partner_many2one"/>
                        <field name="device_id" />
                        <field name="name" />
                        <field name="url" widget="CopyClipboardChar" placeholder="e.g. https://www.google.com"/>
                        <field name="ip_name" />
                        <field name="user_name" widget="CopyClipboardChar"/>
                        <field name="password_name" widget="CopyClipboardChar" password="True"/>
                        <field name="responsible_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="description" />
                        <field name="password_form_id" readonly="True" invisible="1"/>
                        <field name="id" readonly="True"/>
                    </group>
                </sheet> 
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" option="{'post_refresh' : 'recipients'}"/>
                </div>  
            </form>
        </field>
    </record>


    <record id="action_device_list_lines" model="ir.actions.act_window">
        <field name="name">All Passwords</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">device.list.lines</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem name="All Passwords"
              id="menu_lines"
              parent="menu_pasw_root"
              action="action_device_list_lines"
              sequence="1"/>
</odoo>